{
  "name": "n8n-nodes-injective",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Injective blockchain providing 24 resources and 200+ operations for DeFi trading, staking, governance, and cross-chain operations. Includes spot/derivative trading, position management, Peggy bridge, IBC transfers, and real-time WebSocket streaming.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-injective.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-injective",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-injective/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "injective",
    "blockchain",
    "defi",
    "cosmos",
    "trading",
    "derivatives",
    "perpetuals",
    "spot",
    "dex",
    "exchange",
    "staking",
    "governance",
    "ibc",
    "bridge",
    "peggy",
    "ethereum",
    "web3",
    "crypto",
    "automation",
    "workflow"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "LICENSING_FAQ.md",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/InjectiveNetwork.credentials.js",
      "dist/credentials/InjectiveApi.credentials.js",
      "dist/credentials/InjectiveEvm.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Injective/Injective.node.js",
      "dist/nodes/Injective/InjectiveTrigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@injectivelabs/sdk-ts": "^1.14.0",
    "@injectivelabs/networks": "^1.14.0",
    "@injectivelabs/utils": "^1.14.0",
    "@injectivelabs/ts-types": "^1.14.0",
    "@injectivelabs/exceptions": "^1.14.0",
    "@cosmjs/stargate": "^0.32.0",
    "@cosmjs/proto-signing": "^0.32.0",
    "@cosmjs/amino": "^0.32.0",
    "@cosmjs/crypto": "^0.32.0",
    "axios": "^1.6.0",
    "bignumber.js": "^9.1.2",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "gulp-rename": "^2.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "1.57.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  }
}